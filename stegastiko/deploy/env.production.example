# Copy to stegastiko/.env on the server and fill in the values (see deploy/DEPLOY.md).

# Hostname the site is served on. Without a domain, use the server's static IP via sslip.io,
# e.g. for 3.120.45.67 -> 3-120-45-67.sslip.io
SITE_ADDRESS=3-120-45-67.sslip.io
DJANGO_ALLOWED_HOSTS=3-120-45-67.sslip.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://3-120-45-67.sslip.io

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Set to False only to test over plain HTTP (no certificate).
DJANGO_HTTPS=True
